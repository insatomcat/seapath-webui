#
# Installed to /etc/containers/systemd/. Templated by the
# deploy_seapath_webui role at M5, and shipped as is by the ISO before that.
#
# Note how small the host surface is. The configuration plane goes out over
# SSH, even to the local node, so no host configuration is ever written from
# here. Nothing below is writable except the service's own state and, from M1,
# the .ssh directory of the `ansible` account, which is the trust material.
#
# What this container is *not* given is worth as much as what it is: no route
# to the host's systemd, its bus or its journal. Live state belongs to
# prometheus-node-exporter, which every SEAPATH node already runs. The reading
# that stays here answers a different question, the one no exporter answers:
# what this machine *is*, which is what the inventory form is prefilled from.

[Unit]
Description=SEAPATH management web UI and API
After=network-online.target libvirtd.service
Wants=network-online.target

[Container]
Image=docker.io/insatomcat/seapath-webui:latest
ContainerName=seapath-webui
Network=host

# Service state: PKI, session secret, and from M1 the SSH keys, the run traces
# and the artefact store, which holds the VM images and archives an inventory
# names and git has no business carrying. The inventory repository is separate
# so it can be backed up, cloned and exported on its own, and it holds the
# whole folder: `inventory.yaml` and the configuration files it references.
Volume=/etc/seapath/webui:/etc/seapath/webui:rw
Volume=/etc/seapath/inventory:/etc/seapath/inventory:rw
Volume=/var/lib/seapath-webui:/var/lib/seapath-webui:rw

# Trust material, from M1: where this node's own key and the peer keys are
# installed for the `ansible` account. Templated by the role from the account's
# real home, never hardcoded. The service appends single lines to
# authorized_keys and never rewrites the file, because the ISO seeded it with
# the site key that a conventional Ansible control machine uses.
Volume=/home/ansible/.ssh:/home/ansible/.ssh:rw

# Node identity. The container has its own UTS namespace, so without these the
# view would show a container id instead of the machine's name, and the
# certificate would be issued to one.
Volume=/etc/hostname:/etc/hostname:ro
Volume=/etc/os-release:/etc/os-release:ro

# The machine's public SSH host keys. Read off the filesystem so the first SSH
# connection is verified without prompting and without accepting an unverified
# key. No network is involved, so there is nothing to intercept.
Volume=/etc/ssh:/etc/ssh:ro

# Hardware, which is what discovery prefills the inventory form from at first
# boot, before anything is configured and before an exporter is necessarily
# reachable. No exporter publishes this in a usable form either: what
# ceph_osd_disks needs is the stable by-path name of a disk, not a metric
# about it.
# /proc is deliberately not mounted: uptime, cpuinfo, cmdline, stat and, with
# the host network namespace, net/route are not namespaced, so the container's
# own /proc already reports the host's values.
Volume=/sys:/sys:ro
# The stable by-path names, which are what ceph_osd_disks holds. The whole
# device tree is not needed, only the symlinks.
Volume=/dev/disk:/dev/disk:ro
# The directory, not corosync.conf itself: that file only appears once
# cluster_setup_ha.yaml has run, and a bind mount of a source that does not
# exist keeps the container from starting on a standalone node. Its presence
# is the signal that tells a cluster member from a standalone machine, and it
# is the same signal the rest of the SEAPATH tooling uses.
Volume=/etc/corosync:/etc/corosync:ro

# Runtime plane, from M2.
Volume=/var/run/libvirt/libvirt-sock:/var/run/libvirt/libvirt-sock
Volume=/etc/ceph:/etc/ceph:ro

# PAM authentication against the local accounts, and the Unix group that grants
# each role. The whole directory read only, rather than a bind mount of
# /etc/passwd, /etc/group and /etc/shadow: `usermod` and `passwd` write a new
# file and rename it over the old one, so a bind mount of the file pins the
# inode the container started with, and an operator added to seapath-admin stays
# locked out until this service is restarted. The image symlinks the three files
# into this mount, and a symlink is resolved at every open.
Volume=/etc:/run/host/etc:ro

Environment=PYTHONUNBUFFERED=1
# Administration address, from ip_addr in the inventory. Substituted by the
# role, and left unset here so a fresh ISO listens on every address.
#Environment=SEAPATH_WEBUI_BIND_ADDRESS=192.168.200.121
# Extra names in the self signed certificate, from ip_addr and, in a cluster,
# cluster_ip_addr. Only affects how loudly the browser complains: what the
# operator verifies is the fingerprint printed on the console.
#Environment=SEAPATH_WEBUI_TLS_ADDITIONAL_SANS=192.168.200.121,192.168.55.1

[Service]
Restart=always
RestartSec=5

# Dropping this file on a machine and starting the unit has to be enough. A
# missing bind mount source is a container that does not start, and podman
# cannot be relied on to create one, so the directories are created here rather
# than left to the Ansible role, to the ISO, or to the operator's memory. All of
# them are inert when empty, which is what makes creating them harmless, and
# that is a real constraint rather than a formality: this list may never grow a
# path where an empty directory means something, /var/log/journal above all,
# whose creation is what turns the host's journal persistent.
ExecStartPre=/usr/bin/mkdir -p /etc/seapath/webui /etc/seapath/inventory \
    /var/lib/seapath-webui /etc/corosync /etc/ceph
# The TLS private key, the SSH private key and the session secret live there.
ExecStartPre=/usr/bin/chmod 0700 /etc/seapath/webui
# Housekeeping CPUs only, substituted from the node's isolated set by the
# Ansible role. Never a hardcoded value, and the exact opposite of the rtperfui
# quadlet: this service must never compete with a real time guest.
CPUAffinity=0-1
CPUQuota=50%
Nice=5

[Install]
WantedBy=multi-user.target
